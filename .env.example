# ---------------------------------------------------------------------------
# GlobalLinkup environment — copy to .env.local and fill in the values.
#
# Local Supabase runs on the project-specific 545xx ports; see
# docs/plan/api-layer/README.md §2 and supabase/config.toml. Get the keys with:
#   npm run db:start && npm run db:status -- -o env
# ---------------------------------------------------------------------------

# Public — exposed to the browser via NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin, used to build absolute links (e.g. the password-reset
# redirect). Set this in production; optional locally, where it falls back to the
# request host.
# NEXT_PUBLIC_SITE_URL=https://globallinkup.com

# Marketplace concierge contact. These are public values (they render in the
# catalog and inquiry dialog); keep them here for easy access. The
# `platform_settings.marketplace.contact` row remains the source of truth when
# present, with these values used as a fallback.
NEXT_PUBLIC_MARKETPLACE_EMAIL=concierge@globallinkup.com
NEXT_PUBLIC_MARKETPLACE_WHATSAPP=+34 612 345 678
NEXT_PUBLIC_MARKETPLACE_WHATSAPP_LINK=https://wa.me/34612345678

# Server-only — never exposed to the client, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap admin (PRD D6): used by the **cloud** bootstrap to promote the
# matching account to `admin`. The local dev seed ignores this and always seeds
# `admin@globallinkup.test` (see supabase/seed.sql). Optional.
# ADMIN_EMAIL=admin@example.com
