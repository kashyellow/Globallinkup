# ---------------------------------------------------------------------------
# GlobalLinkup environment — copy to .env.local and fill in the values.
#
# Local Supabase runs on the project-specific 545xx ports; see
# docs/plan/api-layer/README.md §2 and supabase/config.toml. Get the keys with:
#   npm run db:start && npm run db:status -- -o env
# ---------------------------------------------------------------------------

# NOTE
# It turns out Supabase anon and service_role API keys are legacy API keys, 
# might need to move to publishable and secret key in the future


# Public — exposed to the browser via NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin, used to build absolute links (e.g. the password-reset
# redirect). Set this in production; optional locally, where it falls back to the
# request host.
# NEXT_PUBLIC_SITE_URL=https://globallinkup.com

# Marketplace concierge contact. These are public values (they render in the
# catalog and inquiry dialog); keep them here for easy access. The
# `platform_settings.marketplace.contact` row remains the source of truth when
# present, with these values used as a fallback.
# On a deployed project `db push` never runs seed.sql, so create the reference
# rows once in the Supabase SQL editor (or a one-off script). The database row
# wins over the env fallback above when it exists.
#
#   insert into public.platform_settings (key, value)
#   values
#     ('marketplace.contact', '{"email":"youremail@yourprovider.com"}'::jsonb),
#     ('marketplace.currency', '"USD"'::jsonb)
#   on conflict (key) do update set value = excluded.value;
#
# Replace the email with the real concierge address before running it.
NEXT_PUBLIC_MARKETPLACE_EMAIL=youremail@yourprovider.com

# Server-only — never exposed to the client, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap admin (PRD D6): the account `npm run admin:bootstrap` creates or
# promotes to `admin`. `supabase db push` never runs the seed, so a fresh cloud
# project starts without an admin; `-- --create` makes one without the persona
# funnel. `admin@globallinkup.test` only exists in the local seed — use a real
# address for a deployed project.
ADMIN_EMAIL=admin@globallinkup.test

# Cron — daily content purge plus notification/audit retention. Vercel Cron calls
# /api/cron/purge once a day; the route rejects any request without this header.
CRON_SECRET=

# SMTP — Supabase Auth sends confirmation, reset, and invite mail. The built-in
# SMTP is rate-limited, so a deployed project needs a provider (Resend, Postmark,
# …). Configure it in the Supabase dashboard, not in this file.

